# Copy to .env and adjust. Never commit real secrets.

# --- Core ---
# Public base URL used in emails (confirmation links).
BASE_URL=http://localhost:8000
# SQLite for dev; swap for Postgres in prod, e.g.
# DATABASE_URL=postgresql+psycopg://mo:mo@db:5432/mo_academy
DATABASE_URL=sqlite:////data/mo_academy.sqlite3

# --- Email ---
# "console" logs emails to stdout (dev). "smtp" sends for real.
EMAIL_BACKEND=console
EMAIL_FROM=MO Academy <hello@example.com>
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# --- Admin ---
# Token required (X-Admin-Token header) for admin endpoints such as CSV export.
ADMIN_TOKEN=change-me

# --- Payments ---
# Payments are stubbed. When false, checkout falls back to a waitlist.
PAYMENTS_ENABLED=false

# --- Auth ---
# Set true in production (HTTPS) so session cookies are marked Secure.
COOKIE_SECURE=false

# --- Lab grading ---
# "docker" runs student code sandboxed (requires the mo-academy-grader image
# and access to the Docker socket). "subprocess" is unsandboxed — dev only.
GRADER_MODE=subprocess
GRADER_IMAGE=mo-academy-grader
GRADER_TIMEOUT=180
